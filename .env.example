# Database configuration
DATABASE_URL="file:sqlite.db"

# Admin configuration
APP_URL="http://localhost:3000"
ADMIN_PASSWORD=your_secure_password

# Public Site Configuration (required at startup)
# Ссылка на официальный Telegram-канал
NEXT_PUBLIC_TELEGRAM_URL="https://t.me/fraiters"

# Юзернейм/хэндл Telegram-канала без @ или с @ (например, @fraiters)
NEXT_PUBLIC_TELEGRAM_HANDLE="@fraiters"

# Канонический URL сайта
NEXT_PUBLIC_SITE_URL="https://fraiters.ru"

# Название сайта / бренда
NEXT_PUBLIC_SITE_NAME="Fraiters Merch"
